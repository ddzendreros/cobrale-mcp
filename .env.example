# Copia este archivo a .env y llena lo que tengas. Sin keys, todo corre en modo demo.

# --- IA: Claude u OpenAI (si pones las dos keys, se usa Claude) ---
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude (default claude-opus-5-5).
ANTHROPIC_MODEL=

OPENAI_API_KEY=
# Opcional: fuerza un modelo. Si lo dejas vacío, se elige el mejor disponible para tu key.
OPENAI_MODEL=

# --- pey (portal.mipey.mx/developers) ---
PEY_API_KEY=
# Secreto del webhook (whsec_...). Aparece al crear el webhook en el portal.
PEY_WEBHOOK_SECRET=
# Opcional: id de la cuenta bancaria pey a la que caen los pagos
PEY_BANK_ACCOUNT_ID=
# Opcional: cobra este monto en lugar del real (ej. 0.01) para probar sin gastar
PEY_TEST_AMOUNT=

# --- App ---
PORT=3000
# URL pública HTTPS (túnel cloudflared / deploy). Necesaria para webhooks y links de pago.
PUBLIC_URL=
STORE_NAME=Abarrotes La Esperanza
STORE_OWNER=Don Pepe
# Zona horaria para fechas locales.
TZ=America/Mexico_City
# Carpeta de datos; en Railway con volumen puedes usar /data.
DATA_DIR=
# Pon 1 para dejar el botón "Simular pago" aun con pey en vivo
ALLOW_SIMULATE=
# Pon 1 para registrar en logs los webhooks crudos (máximo 30).
PEY_DEBUG=

# --- MCP ---
# Opcional: si lo defines, /mcp exige Authorization: Bearer <token>
PEY_MCP_TOKEN=
